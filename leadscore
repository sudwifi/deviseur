// Même logique que le Deviseur Wifi : base = relais Cloudflare (ou axonaut.com), chemins /api/v2/…
function axBase(raw){let u=(raw||'').trim().replace(/\/+$/,'');if(!u)return'https://axonaut.com';if(!/^https?:\/\//i.test(u))u='https://'+u;
  u=u.replace(/^(https?:\/\/)app\.axonaut\.com/i,'$1axonaut.com');return u.replace(/\/api(\/.*)?$/i,'')}
const axH=()=>({'userApiKey':settings.apiKey,'Content-Type':'application/json','Accept':'application/json'});
async function ax(path,body){
  const r=await fetch(axBase(settings.api)+'/api/v2'+path,{method:'POST',headers:axH(),body:JSON.stringify(body)});
  const txt=await r.text();let j;try{j=JSON.parse(txt)}catch(e){j=txt}
  if(!r.ok)throw new Error(`HTTP ${r.status} ${typeof j==='string'?j:JSON.stringify(j)}`.slice(0,300));return j}
const norm=n=>(n||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
let axIdx=null; // index des entreprises Axonaut (chargé une fois) ; false = lecture de la liste refusée
async function axLoadIndex(){
  if(axIdx!==null)return axIdx;const all=[];let first=null;
  for(let p=1;p<=30;p++){
    const r=await fetch(`${axBase(settings.api)}/api/v2/companies?page=${p}`,{headers:axH()});
    if(r.status===404&&p>1)break;
    if(r.status===403||r.status===404){if(!all.length){axIdx=false;return false}break}
    if(!r.ok)throw new Error(`Recherche entreprise : HTTP ${r.status}`);
    const d=await r.json();const list=Array.isArray(d)?d:(d.data||d.companies||[]);
    if(!list.length)break;if(list[0]&&list[0].id===first)break;first=list[0]&&list[0].id;all.push(...list)}
  axIdx=all;return all}
