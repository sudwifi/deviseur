  const rows=leads.filter(l=>!isEmpty(l)).map(l=>{const s=score(l),T=TEMPS[s.t];
    return[l.entreprise||(l.prenom+' '+l.nom).trim(),l.prenom,l.nom,l.email,l.tel,`SETT 2026 – ${l.entreprise||l.nom}`,Number(l.budgetEstime)||0,probOf(l),l.commercial,settings.pipe,stepName(l),today,'',commentFor(l),T.imp,U[l.timing]||1].map(q).join(',')});
  dl(`SETT2026-import-axonaut-${stamp()}.csv`,[H.map(q).join(','),...rows].join('\n'),'text/csv;charset=utf-8');toast(`📄 CSV généré (colonnes du fichier leads 2025)`,5000)};

/* ---------- Réglages ---------- */
$('#btnSet').onclick=()=>{$('#sKey').value=settings.apiKey;$('#sMgr').value=settings.manager;$('#sPipe').value=settings.pipe;$('#sOrig').value=settings.origine;$('#sApi').value=settings.api;$('#sWifi').value=settings.urlWifi;$('#sVideo').value=settings.urlVideo;$('#dlg').showModal()};
$('#sClose').onclick=()=>$('#dlg').close();
$('#sSave').onclick=()=>{settings={...settings,apiKey:$('#sKey').value.trim(),manager:$('#sMgr').value.trim(),pipe:$('#sPipe').value.trim(),origine:$('#sOrig').value.trim(),api:$('#sApi').value.trim(),urlWifi:$('#sWifi').value.trim(),urlVideo:$('#sVideo').value.trim()};saveSettings();$('#dlg').close();toast('Réglages enregistrés')};

/* ---------- Navigation / init ---------- */
$('#tabEdit').onclick=()=>show('edit');$('#tabList').onclick=()=>{persist(true);show('list')};
$('#newLead').onclick=()=>{persist(true);cur=newLead();buildQual();render();show('edit');window.scrollTo(0,0);$('[data-f=entreprise]').focus()};
addEventListener('beforeunload',()=>persist(true));
net();$('#cnt').textContent=leads.length;
if(!cur){cur=newLead()}
buildQual();render();show('edit');
</script>
</body>
