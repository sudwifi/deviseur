async function updateLead(l){
  if(!l.ax||!l.ax.oppId)return'déjà envoyé';
  const idx=stepIdx(stepKey(l));const body={};
  if(idx>(l.ax.stepIdx??-1))body.pipe_step_name=stepName(l);
  const amt=Number(l.budgetEstime)||0;if(amt&&amt!==l.ax.amount)body.amount=amt;
  const com=commentFor(l);if(com!==l.ax.comment)body.comments=com;
  const pr=probOf(l);if(pr!==l.ax.prob)body.probability=pr;
  const mg=mgrOf(l);if(mg!==l.ax.manager)body.business_manager_email=mg;
  if(!Object.keys(body).length)return'à jour';
  const r=await fetch(axBase(settings.api)+'/api/v2/opportunities/'+l.ax.oppId,{method:'PATCH',headers:axH(),body:JSON.stringify(body)});
  if(!r.ok){const t=await r.text();throw new Error(('HTTP '+r.status+' '+t).slice(0,300))}
  if(body.pipe_step_name)l.ax.stepIdx=idx;if(body.amount)l.ax.amount=amt;
  l.ax.comment=com;l.ax.prob=pr;l.ax.manager=mg;l.ax.updatedAt=Date.now();persist(true);return'mis à jour'}
async function sendLead(l){
  if(l.ax?.status==='sent')return await updateLead(l);
  const name=l.entreprise||(l.prenom+' '+l.nom).trim();
  if(!name)throw new Error('Entreprise ou nom manquant');
  if(!settings.apiKey)throw new Error('Clé API Axonaut manquante (⚙)');
  const s=score(l),T=TEMPS[s.t];
  l.ax=l.ax||{};
  try{
    if(!l.ax.companyId){
      // 1) l'entreprise existe-t-elle déjà ? (évite les doublons avec les clients actuels)
      let found=null;
      try{found=await axFind(name)}catch(e){if(/Failed to fetch|NetworkError|Load failed/i.test(e.message))throw e;found=undefined}
      if(found&&found.id){l.ax.companyId=found.id;l.ax.existing=true}
      else{
        if(l.client==='oui'&&!confirm(`« ${name} » est marqué client actuel mais reste introuvable dans Axonaut${found===undefined?' (recherche impossible)':''}.\nCréer un nouveau prospect quand même ?`))throw new Error('Envoi annulé (client existant à rattacher à la main)');
        const emp={firstname:l.prenom,lastname:l.nom||l.entreprise,email:l.email,job:l.fonction};
        if(l.tel){l.telType==='perso'?emp.cellphoneNumber=l.tel:emp.phoneNumber=l.tel}
        const c=await ax('/companies',{name:name,is_prospect:true,is_customer:false,address_city:l.ville||undefined,business_manager:mgrOf(l),comments:commentFor(l),employees:(l.prenom||l.nom||l.email||l.tel)?[emp]:[]});
        l.ax.companyId=c.id;if(Array.isArray(axIdx))axIdx.push({id:c.id,name});
      }}
    const payload={company_id:l.ax.companyId,name:`SETT 2026 – ${name}`,pipe_name:settings.pipe,pipe_step_name:stepName(l),business_manager_email:mgrOf(l),amount:Number(l.budgetEstime)||0,probability:probOf(l),comments:commentFor(l),
      employees:(l.email||l.tel||l.nom)?[{employee_firstname:l.prenom,employee_lastname:l.nom,employee_email:l.email,employee_phone:l.telType==='perso'?undefined:l.tel,employee_cellphone:l.telType==='perso'?l.tel:undefined}]:undefined};
    // Champ personnalisé « Origine » ; si Axonaut refuse la valeur, on recrée sans et on le signale
    let o,noOrigine=false;
    try{o=await ax('/opportunities',{...payload,custom_fields:{'Origine':settings.origine}})}
    catch(e){if(!/HTTP (400|422)/.test(e.message))throw e;o=await ax('/opportunities',payload);noOrigine=true}
    l.ax={...l.ax,status:'sent',oppId:o.id,stepIdx:stepIdx(stepKey(l)),amount:Number(l.budgetEstime)||0,comment:payload.comments,prob:payload.probability,manager:payload.business_manager_email,noOrigine,sentAt:Date.now(),error:''};
  }catch(e){l.ax.status='error';l.ax.error=String(e.message||e);persist(true);throw e}
  persist(true)}
