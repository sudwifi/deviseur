<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>SETT 2026 · Fiche lead Sud Wifi</title>
<style>
:root{--bg:#f3f5f9;--card:#fff;--ink:#14213d;--mut:#64708a;--line:#dde3ee;--brand:#0b6bcb;--brand2:#0a4f99;--ok:#16a34a;--ko:#dc2626;--r:14px}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink);font-size:16px;padding-bottom:90px}
header{background:var(--ink);color:#fff;padding:10px 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;position:sticky;top:0;z-index:30}
header h1{font-size:17px;margin:0;flex:1;min-width:150px}header h1 small{display:block;font-weight:400;opacity:.7;font-size:12px}
.net{font-size:12px;padding:4px 9px;border-radius:99px;background:#1f3257}.net.on{background:#14532d}.net.off{background:#7f1d1d}
.tabs{display:flex;gap:6px}.tabs button,.ib{background:#1f3257;color:#fff;border:0;border-radius:10px;padding:9px 13px;font-size:15px;font-weight:600}
.tabs button.act{background:var(--brand)}
main{max-width:820px;margin:0 auto;padding:12px}
.card{background:var(--card);border-radius:var(--r);padding:14px;margin-bottom:12px;box-shadow:0 1px 3px #0001}
.card h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut);margin:0 0 10px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.full{grid-column:1/-1}
@media(max-width:560px){.grid{grid-template-columns:1fr}}
label{display:block;font-size:12px;color:var(--mut);margin-bottom:3px;font-weight:600}
input[type=text],input[type=email],input[type=tel],input[type=number],input[type=password],input[type=url],select,textarea{width:100%;font:inherit;padding:12px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--brand)}
textarea{min-height:90px;resize:vertical}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:10px;padding:10px 13px;font-size:15px;font-weight:600;color:var(--ink);line-height:1.15}
.chip small{display:block;font-weight:500;color:var(--mut);font-size:11px;margin-top:2px}
.chip.on{background:var(--brand);border-color:var(--brand);color:#fff}.chip.on small{color:#dbeafe}
.crit{margin-bottom:14px}.crit>label{font-size:13px;color:var(--ink);margin-bottom:6px}
.score{position:sticky;top:57px;z-index:20;border-radius:var(--r);color:#fff;padding:10px 14px;margin-bottom:12px;box-shadow:0 3px 10px #0003;transition:background .25s}
.score .top{display:flex;align-items:center;gap:12px}
.score .big{font-size:26px;font-weight:900;letter-spacing:.02em;flex:1;line-height:1.05}
.score .big small{display:block;font-size:12px;font-weight:600;opacity:.9;letter-spacing:0}
.score .num{font-size:34px;font-weight:900}.score .num small{font-size:14px;opacity:.8}
.pills{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.pill{background:#0003;border-radius:8px;padding:3px 8px;font-size:12px;font-weight:600}.pill.na{opacity:.5}
.cap{font-size:12px;margin-top:6px;opacity:.95}
.btns{display:flex;flex-wrap:wrap;gap:8px}
.btn{border:0;border-radius:12px;padding:13px 16px;font-size:15px;font-weight:700;background:var(--brand);color:#fff;flex:1;min-width:140px}
.btn.sec{background:#e8eef9;color:var(--brand2)}.btn.ax{background:#7c3aed}.btn.gr{background:var(--ok)}.btn.red{background:#fee2e2;color:var(--ko)}
.btn:active{filter:brightness(.9)}.btn[disabled]{opacity:.5}
.lead{display:flex;gap:10px;align-items:center;padding:12px;border-radius:12px;background:#fff;margin-bottom:8px;border-left:8px solid var(--c);box-shadow:0 1px 3px #0001}
.lead .t{font-weight:800;font-size:13px;min-width:78px;color:var(--c)}.lead .i{flex:1;min-width:0}
.lead .i b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lead .i span{font-size:13px;color:var(--mut)}
.lead .s{font-size:12px;text-align:right;color:var(--mut)}.lead a{color:var(--brand);text-decoration:none}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px}
.stat{border-radius:12px;padding:10px 4px;text-align:center;color:#fff;font-weight:800;font-size:12px;border:3px solid transparent}.stat b{display:block;font-size:24px}.stat.on{border-color:var(--ink)}
.bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:9px 12px;z-index:40}
.bar .btns{max-width:820px;margin:0 auto}
.toast{position:fixed;left:50%;bottom:100px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 18px;border-radius:12px;z-index:60;max-width:90%;font-size:14px;display:none;box-shadow:0 4px 14px #0004}
dialog{border:0;border-radius:var(--r);padding:18px;max-width:560px;width:94%}dialog::backdrop{background:#0008}
pre{background:#0f172a;color:#e2e8f0;padding:10px;border-radius:8px;overflow:auto;font-size:12px}
.hint{font-size:12px;color:var(--mut)}.hide{display:none!important}
.chk{display:flex;gap:12px;align-items:center;font-size:15px;color:var(--ink);font-weight:600;background:#eef3fb;padding:12px;border-radius:10px;margin:0}
.chk input{width:28px;height:28px;flex:none;accent-color:var(--brand)}.chk .hint{font-weight:500}
</style>
</head>
<body>
<header>
  <h1>SETT 2026 · Fiche lead<small>Sud Wifi · Hall B3 – Stand D41</small></h1>
  <span class="net" id="net">…</span>
  <div class="tabs"><button id="tabEdit" class="act">Fiche</button><button id="tabList">Leads (<span id="cnt">0</span>)</button><button class="ib" id="btnSet">⚙</button></div>
</header>

<main>
<!-- ============ FICHE ============ -->
<section id="viewEdit">
  <div class="score" id="score" style="background:#64748b">
    <div class="top"><div class="big" id="sLabel">À QUALIFIER<small id="sSub">Renseignez les critères</small></div><div class="num"><span id="sNum">0</span><small>/100</small></div></div>
    <div class="pills" id="sPills"></div><div class="cap hide" id="sCap"></div>
  </div>

  <div class="card"><h2>Contact</h2>
    <div class="grid">
      <div class="full"><label>Entreprise / site *</label><input type="text" data-f="entreprise" autocomplete="off" placeholder="Camping Les Pins…"></div>
      <div><label>Prénom</label><input type="text" data-f="prenom" autocomplete="off"></div>
      <div><label>Nom</label><input type="text" data-f="nom" autocomplete="off"></div>
      <div><label>Email pro</label><input type="email" data-f="email" inputmode="email" autocapitalize="off" autocomplete="off"></div>
      <div><label>Téléphone</label><input type="tel" data-f="tel" inputmode="tel" autocomplete="off"></div>
      <div><label>Type de numéro</label><div class="chips" data-chip="telType"><button class="chip" data-v="pro">Pro</button><button class="chip" data-v="perso">Perso</button></div></div>
      <div><label>Fonction</label><div class="chips" data-chip="fonction"><button class="chip" data-v="Gérant / Dirigeant">Dirigeant</button><button class="chip" data-v="Directeur / Responsable">Directeur</button><button class="chip" data-v="Technique / IT">Technique</button><button class="chip" data-v="Autre">Autre</button></div></div>
      <div><label>Ville</label><input type="text" data-f="ville" autocomplete="off"></div>
      <div><label>Client Sud Wifi actuel ?</label><div class="chips" data-chip="client"><button class="chip" data-v="oui">Oui</button><button class="chip" data-v="non">Non</button></div></div>
      <div class="full"><label class="chk"><input type="checkbox" data-c="consent"><span>Accord verbal recueilli <span class="hint">(précaution · base : badge SETT, données partagées avec les exposants partenaires)</span> <span class="hint" id="consentAt"></span></span></label></div>
    </div>
  </div>

  <div class="card"><h2>Qualification (scoring auto)</h2>
    <div class="crit"><label>1 · Typologie du site</label><div class="chips" id="cType"></div></div>
    <div class="crit" id="critClass"><label>2 · Classement</label><div class="chips" id="cClass"></div></div>
    <div class="crit"><label>3 · Capacité <span id="capUnit" class="hint"></span></label>
      <div class="chips" id="cCap"></div>
      <div style="margin-top:8px;max-width:220px"><input type="number" inputmode="numeric" data-f="capaciteNb" placeholder="Nombre exact (optionnel)"></div></div>
    <div class="crit"><label>4 · Timing du projet</label><div class="chips" id="cTiming"></div></div>
    <div class="crit"><label>5 · Budget validé</label><div class="chips" id="cBudget"></div></div>
    <div class="crit"><label>6 · Décideur présent</label><div class="chips" id="cDec"></div></div>
    <div class="crit"><label>7 · Engagement chez le prestataire actuel</label>
      <input type="text" data-f="prestataire" placeholder="Nom du prestataire actuel (optionnel)" autocomplete="off" style="max-width:340px;margin-bottom:8px">
      <div style="max-width:200px;margin-bottom:8px"><label>Fin d'engagement (MM-YYYY)</label><input type="text" data-f="finEngagement" inputmode="numeric" placeholder="MM-YYYY" maxlength="7" autocomplete="off"></div>
      <div class="chips" id="cEng"></div>
      <label class="chk" id="resilBox" style="margin-top:8px"><input type="checkbox" data-c="resil"><span>Résiliation envoyée <span class="hint">(décoché = pas envoyée)</span></span></label>
    </div>
  </div>

  <div class="card"><h2>Suite à donner</h2>
    <div class="grid">
      <div class="full"><label>Prochaine action</label><div class="chips" data-chip="action">
        <button class="chip" data-v="Chiffrage sur le stand">Chiffrage sur stand</button><button class="chip" data-v="Démo Tableau de bord">Démo Tableau de bord</button>
        <button class="chip" data-v="Rappel sous 48h">Rappel 48h</button><button class="chip" data-v="Envoi documentation">Envoi doc</button><button class="chip" data-v="Visite sur site">Visite sur site</button><button class="chip" data-v="Aucune">Aucune</button></div></div>
      <div><label>Budget estimé (€ HT)</label><input type="number" inputmode="numeric" data-f="budgetEstime" placeholder="Rempli par le Deviseur si lien"></div>
      <div><label>Commercial</label><div class="chips" data-chip="commercial"><button class="chip" data-v="Virginie">Virginie</button><button class="chip" data-v="Stéphane">Stéphane</button><button class="chip" data-v="Anthony">Anthony</button><button class="chip" data-v="Amanda">Amanda</button></div></div>
      <div class="full"><label>Notes (besoins, contexte, concurrent en place…)</label><textarea data-f="notes"></textarea></div>
    </div>
  </div>

  <div class="card"><h2>Chiffrage</h2>
    <div class="btns"><button class="btn" id="goWifi">📶 Deviseur Wifi</button><button class="btn" id="goVideo">📹 Deviseur vidéo</button></div>
    <p class="hint" style="margin:8px 0 0">Les infos du lead sont transmises automatiquement, sans ressaisie.</p>
  </div>
</section>

<!-- ============ LISTE ============ -->
<section id="viewList" class="hide">
  <div class="stats" id="stats"></div>
  <div class="card" style="padding:10px"><input type="text" id="q" placeholder="🔎 Rechercher (entreprise, nom, tel…)"></div>
  <div id="list"></div>
  <div class="card"><h2>Sauvegarde &amp; export</h2>
    <div class="btns">
      <button class="btn gr" id="bkJson">💾 Sauvegarde fichier (.json)</button>
      <button class="btn sec" id="bkCsv">📄 Export CSV Axonaut</button>
      <button class="btn sec" id="bkImp">📥 Importer une sauvegarde</button>
    </div>
    <input type="file" id="fileImp" accept=".json" class="hide">
    <p class="hint" style="margin-bottom:0">Tout est enregistré en continu sur cet appareil (fonctionne sans réseau). Pensez à une sauvegarde .json en fin de journée.</p>
  </div>
</section>
</main>

<div class="bar"><div class="btns">
  <button class="btn sec" id="newLead">➕ Nouveau lead</button>
  <button class="btn gr" id="saveLocal">💾 Sauvegarder</button>
  <button class="btn ax" id="sendAx">⬆ Axonaut</button>
</div></div>

<div class="toast" id="toast"></div>

<dialog id="dlg">
  <h3 style="margin-top:0">Réglages</h3>
  <div class="grid">
    <div class="full"><label>Clé API Axonaut (stockée uniquement sur cet appareil)</label><input type="password" id="sKey" autocomplete="off"></div>
    <div><label>E-mail par défaut (si commercial non reconnu)</label><input type="email" id="sMgr"></div>
    <div><label>Pipe commercial</label><input type="text" id="sPipe"></div>
    <div><label>Valeur du champ « Origine »</label><input type="text" id="sOrig"></div>
    <div class="full"><label>URL du relais Axonaut (Cloudflare) — le même que dans le Deviseur Wifi</label><input type="url" id="sApi" placeholder="https://axonaut-relais.xxx.workers.dev"></div>
    <div class="full"><button class="btn sec" id="axTest" type="button">🔌 Tester la connexion Axonaut</button><div class="hint" id="axStatus" style="margin-top:6px"></div></div>
    <div class="full"><label>URL du Deviseur Wifi</label><input type="url" id="sWifi" placeholder="https://…"></div>
    <div class="full"><label>URL du Deviseur vidéo</label><input type="url" id="sVideo" placeholder="https://…"></div>
  </div>
  <details style="margin-top:10px"><summary class="hint">Comment les Deviseurs récupèrent le lead</summary>
    <p class="hint">Les Deviseurs (Wifi V15 et vidéo V5 « SETT ») lisent automatiquement : <code>lead_id, entreprise, prenom, nom, email, tel, ville, typo, capacite, axonaut_id, opp_id, manager, origine, retour</code>. Leur « → Axonaut » crée le devis dans le cycle « Sett 2026 », étape 2, au nom du commercial du lead. Leur « ↩ Fiche lead » renvoie le montant (Wifi + vidéo s'additionnent) et l'opportunité : la fiche se met alors à jour dans Axonaut toute seule.</p></details>
  <div class="btns" style="margin-top:14px"><button class="btn sec" id="sClose">Annuler</button><button class="btn" id="sSave">Enregistrer</button></div>
</dialog>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const LS_L='sett2026_leads_v1',LS_S='sett2026_settings_v1',LS_B='sett2026_leads_backup';
const DEF={apiKey:'',manager:'virginie@sudwifi.fr',pipe:'Sett 2026',origine:'SETT 2026 – stand',api:'',urlWifi:'',urlVideo:'',lastCommercial:'Virginie'};
const MGR={Virginie:'virginie@sudwifi.fr','Stéphane':'stephane@sudwifi.fr',Anthony:'anthony@sudwifi.fr',Amanda:'amanda@sudwifi.fr'};
// Noms EXACTS des étapes du cycle « Sett 2026 » dans Axonaut
const STEPS=[['stand','1. Visite sur Stand'],['chiffre','2 Chiffré / démo sur stand'],['recontact','3 À recontacter post-salon'],['rdv','4 RDV / visite planifié'],['devis','5 Devis à produire']];
const ACT2STEP={'Chiffrage sur le stand':'chiffre','Démo Tableau de bord':'chiffre','Rappel sous 48h':'recontact','Envoi documentation':'recontact','Visite sur site':'rdv'};
const stepIdx=k=>STEPS.findIndex(x=>x[0]===k);
function stepKey(l){let k=ACT2STEP[l.action]||'stand';if(k==='stand'&&(Number(l.montantWifi)||Number(l.montantVideo)))k='chiffre';return k}
const stepName=l=>STEPS[stepIdx(stepKey(l))][1];
const mgrOf=l=>MGR[l.commercial]||settings.manager;
const probOf=l=>Math.min(TEMPS[score(l).t].prob,50); // plafonné à 50 % tant que le devis n'est pas envoyé
const load=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}};
let settings={...DEF,...load(LS_S,{})},leads=load(LS_L,[]),cur=null,filter='all';

/* ---------- Scoring ---------- */
const TEMPS={ultra:{l:'ULTRA CHAUD',e:'🔥🔥',c:'#e11d48',prob:90,imp:5},chaud:{l:'CHAUD',e:'🔥',c:'#f97316',prob:60,imp:4},tiede:{l:'TIÈDE',e:'🌤️',c:'#ca8a04',prob:30,imp:2},froid:{l:'FROID',e:'❄️',c:'#2563eb',prob:10,imp:1}};
const TYPES=[['camping','Camping',15],['hotel','Hôtel / résidence',12],['collectif','Hébergement collectif',12],['commerce','Commerce / resto',6],['entreprise','Entreprise / bureaux',6],['autre','Autre',2]];
const CLASS=[['5','5 ★',10],['4','4 ★',8],['3','3 ★',6],['2','2 ★',3],['0','1 ★ / non classé',1]];
const TIMING=[['now','< 3 mois',25],['q2','3 à 6 mois',18],['q3','6 à 12 mois',9],['far','> 12 mois',4],['none','Pas de projet',0]];
const BUDGET=[['ok','Validé',15],['wip','En cours',8],['unk','Non défini',2],['no','Aucun budget',0]];
const DEC=[['yes','Oui, c\'est lui',15],['inf','Influenceur',7],['no','Absent',0]];
const ENG=[['free','Aucun / libre',15],['m6','Fin < 6 mois',12],['m12','Fin dans 6–12 mois',8],['m24','Fin dans 12–24 mois',3],['m24p','Engagé > 24 mois',0],['unk','Ne sait pas',4]];
const ENGAGED=['m6','m12','m24','m24p'];
const CAPS={camping:['empl.',[49,149,299]],hotel:['chambres',[19,59,119]],collectif:['places',[49,149,299]],_:['postes / utilisateurs',[9,29,99]]};
const CAPPTS=[2,8,14,20];
function capDef(type){const [u,m]=CAPS[type]||CAPS._;const L=[`< ${m[0]+1}`,`${m[0]+1}–${m[1]}`,`${m[1]+1}–${m[2]}`,`${m[2]+1}+`];return{unit:u,max:m,opts:L.map((l,i)=>[String(i),l,CAPPTS[i]])}}
const hasClass=t=>t==='camping'||t==='hotel';
const pts=(arr,v)=>{const o=arr.find(x=>x[0]===v);return o?o[2]:null};

function score(l){
  const rows=[];
  const add=(label,arr,v,na)=>rows.push({label,na:!!na,got:na?0:(pts(arr,v)??0),max:na?0:Math.max(...arr.map(x=>x[2])),filled:na?true:v!=null&&v!==''});
  add('Typologie',TYPES,l.type);
  add('Classement',CLASS,l.classement,!hasClass(l.type)&&!!l.type);
  add('Capacité',capDef(l.type).opts,l.capacite);
  add('Timing',TIMING,l.timing);add('Budget',BUDGET,l.budget);add('Décideur',DEC,l.decideur);
  // Engagement : une résiliation envoyée vaut « libre » (points max)
  const engOk=ENGAGED.includes(l.engagement)&&l.resil;
  rows.push({label:'Engagement',na:false,got:engOk?15:(pts(ENG,l.engagement)??0),max:15,filled:!!l.engagement});
  const got=rows.reduce((a,r)=>a+r.got,0),max=rows.reduce((a,r)=>a+r.max,0)||1;
  const filled=rows.filter(r=>!r.na&&r.filled).length;
  const pct=Math.round(got/max*100);
  const RANK={froid:0,tiede:1,chaud:2,ultra:3};
  let t=pct>=75?'ultra':pct>=55?'chaud':pct>=35?'tiede':'froid';
  let cap='';
  const limit=(m,why)=>{if(RANK[t]>RANK[m]){t=m;cap=`Plafonné à ${TEMPS[m].l} : ${why}`}};
  if(l.timing==='none')limit('tiede','pas de projet identifié');
  if(!(l.decideur==='yes'&&(l.timing==='now'||l.timing==='q2')))limit('chaud','ULTRA CHAUD exige décideur présent + projet < 6 mois');
  if(l.engagement==='m24'&&!l.resil)limit('chaud','engagé 12–24 mois, résiliation non envoyée');
  if(l.engagement==='m24p'&&!l.resil)limit('tiede','engagé > 24 mois, résiliation non envoyée');
  return{pct,t,rows,filled,total:rows.filter(r=>!r.na).length,cap};
}

/* ---------- Données ---------- */
const newLead=()=>({id:'L'+Date.now().toString(36),createdAt:Date.now(),updatedAt:Date.now(),entreprise:'',prenom:'',nom:'',email:'',tel:'',telType:'',fonction:'',ville:'',client:'',type:'',classement:'',capacite:'',capaciteNb:'',timing:'',budget:'',decideur:'',budgetEstime:'',montantWifi:'',montantVideo:'',action:'',commercial:settings.lastCommercial,notes:'',prestataire:'',engagement:'',finEngagement:'',resil:false,consent:false,consentAt:'',ax:{status:'todo'}});
const isEmpty=l=>!(l.entreprise||l.nom||l.prenom||l.email||l.tel);
let tmr;
function persist(now){clearTimeout(tmr);const go=()=>{if(cur&&!isEmpty(cur)){cur.updatedAt=Date.now();const i=leads.findIndex(x=>x.id===cur.id);i<0?leads.unshift(cur):leads[i]=cur}
  try{localStorage.setItem(LS_L,JSON.stringify(leads));localStorage.setItem(LS_B,JSON.stringify({at:Date.now(),leads}))}catch(e){toast('⚠️ Stockage local plein ou bloqué : faites une sauvegarde .json')}
  $('#cnt').textContent=leads.length};now?go():tmr=setTimeout(go,350)}
function saveSettings(){localStorage.setItem(LS_S,JSON.stringify(settings))}

/* ---------- UI Fiche ---------- */
function chips(el,arr,key,onPick){el.innerHTML=arr.map(([v,l,p])=>`<button class="chip" data-v="${v}">${esc(l)}${p!=null?`<small>+${p} pts</small>`:''}</button>`).join('');
  el.onclick=e=>{const b=e.target.closest('.chip');if(!b)return;e.preventDefault();cur[key]=cur[key]===b.dataset.v?'':b.dataset.v;onPick&&onPick();render();persist()}}
function buildQual(){
  chips($('#cType'),TYPES,'type',()=>{if(!hasClass(cur.type))cur.classement='';cur.capacite=bucketOf(cur.capaciteNb)});
  chips($('#cClass'),CLASS,'classement');
  const cd=capDef(cur.type);$('#capUnit').textContent=cur.type?`(${cd.unit})`:'';
  chips($('#cCap'),cd.opts,'capacite');
  chips($('#cTiming'),TIMING,'timing');chips($('#cBudget'),BUDGET,'budget');chips($('#cDec'),DEC,'decideur');
  chips($('#cEng'),ENG,'engagement',()=>{if(!ENGAGED.includes(cur.engagement))cur.resil=false});
}
